# Aplicacao
APP_NAME=StudYou Backend
ENVIRONMENT=development

# Banco de dados
DATABASE_URL=postgresql+asyncpg://studyou:studyou@localhost:5432/studyou

# Gemini (Google AI)
GEMINI_API_KEY=changeme
GEMINI_MODEL=gemini-3.8-flash
# Prompt de analise especifico da aplicacao (etapa "Analise do conteudo com base
# no prompt especificado na aplicacao" do fluxo)
GEMINI_ANALYSIS_PROMPT="Voce e um assistente de estudos. Resuma o conteudo do arquivo enviado e extraia os principais topicos, conceitos e possiveis perguntas de revisao."

# Validacao de arquivo
MAX_FILE_SIZE_BYTES=10485760
ALLOWED_FILE_FORMATS=pdf,txt,docx,pptx,png,jpg,jpeg

# Logs
# Nivel: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Arquivo de log separado (com rotacao por tamanho). Deixe vazio para logar apenas no console.
LOG_FILE=logs/studyou.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# Autenticacao -- gere um valor aleatorio proprio, por exemplo com:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=changeme
JWT_EXPIRES_MINUTES=43200

# Token mestre -- APENAS para testes (Swagger, Postman, app em desenvolvimento).
# Enviado como "Authorization: Bearer <MASTER_TOKEN>", autentica como o usuario
# MASTER_TOKEN_USER_EMAIL sem login (o usuario e criado automaticamente se nao existir).
# Deixe vazio para desativar. Minimo de 32 caracteres; a API nao sobe com ele em producao.
# MASTER_TOKEN_USER_EMAIL pode ficar vazio ou ser omitido: usa master@studyou.local.
# Gere um com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MASTER_TOKEN=
MASTER_TOKEN_USER_EMAIL=
