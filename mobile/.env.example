# URL base do backend StudYou usada pelo app para enviar arquivos para analise.
#
# - Dispositivo fisico via USB + "adb reverse tcp:8000 tcp:8000": http://localhost:8000
# - Emulador Android: http://10.0.2.2:8000
# - Dispositivo na mesma rede Wi-Fi da maquina rodando o backend: http://<ip-da-maquina>:8000
# - Backend publicado: a URL real de producao.
BACKEND_BASE_URL=http://localhost:8000
